# ---------------------------------------------------------------------------
# Supabase-yhteyden asetukset
# Kopioi tämä tiedosto nimelle .env.local (tai config/.env) ja täytä arvot.
# Älä koskaan lisää oikeita avaimia versionhallintaan.
# ---------------------------------------------------------------------------

# Supabase-projektin julkinen URL. Näkyy selaimelle (Next.js upottaa sen
# NEXT_PUBLIC_-etuliitteen vuoksi), mutta se ei ole salaisuus.
# Muoto: https://<projektitunnus>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase-projektin julkinen avain (publishable key, sb_publishable_...).
# Selain ei keskustele Supabasen kanssa suoraan tässä sovelluksessa, joten
# tätä ei vaadita ajonaikaisesti. Se on mukana yhteensopivuuden vuoksi.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PALVELINPUOLEN SALAINEN AVAIN (secret key, sb_secret_...).
# Saa olla vain palvelimella. Älä koskaan käytä NEXT_PUBLIC_-etuliitettä
# tähän muuttujaan. Tämä avain ohittaa RLS:n, ja sitä käyttävät ainoastaan
# palvelinpuolen route handlerit.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Valinnainen: julkinen osoite, jota QR-koodi käyttää.
# Jos tätä ei aseteta, QR-koodi käyttää selaimen nykyistä osoitetta.
# Aseta tämä tuotannossa, esimerkiksi https://visa.example.com
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://visa.example.com
